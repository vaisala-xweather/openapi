{
  "name": "@xweather/weather-api-openapi",
  "version": "1.0.0",
  "private": true,
  "description": "Public OpenAPI descriptions and reference for the Xweather Weather API",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "npm run lint:redocly && npm run lint:spectral",
    "lint:redocly": "redocly lint",
    "lint:spectral": "spectral lint weather-api.yaml weather-api-3.1.yaml --ruleset .spectral.yaml --fail-severity error",
    "check": "npm test && npm run lint",
    "build:site": "node scripts/build-site.mjs",
    "preview": "npm run build:site && python3 -m http.server 8080 --bind 127.0.0.1 --directory _site"
  },
  "devDependencies": {
    "@redocly/cli": "2.53.3",
    "@stoplight/spectral-cli": "6.16.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  }
}
